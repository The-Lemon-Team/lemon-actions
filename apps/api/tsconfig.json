{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@lemon/core-combinator": ["../../packages/core-combinator/dist"],
      "@lemon/core-combinator-sdk": ["../../packages/core-combinator-sdk/dist"],
      "@lemon/seasons-neurons": ["../../packages/lemon-seasons-neurons/dist"],
      "@lemon/app-registrar": ["../../packages/lemon-app-registrar/dist"],
      "@lemon/projectarium": ["../../packages/lemon-projectarium/dist"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false
  }
}
