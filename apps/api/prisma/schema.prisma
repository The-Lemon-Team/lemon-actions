generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [ltree]
}

enum FlowType {
  CONTEXT
  MUTEX
  OBSERVER
  FSM
  TIMER
  CIRCUIT_BREAKER
  BATCH
  PROJECTION
}

enum FlowStatus {
  INACTIVE
  ACTIVE
  PAUSED
  PROCESSING
}

enum ActionType {
  FSM
  SLA
  TIMER
  COUNTER
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  handle      String   @unique
  displayName String   @map("display_name")
  avatarIcon  String?  @map("avatar_icon")
  createdAt   DateTime @default(now()) @map("created_at")

  folders Folder[]
  flows   Flow[]

  @@map("profiles")
}

model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  profileId String?  @map("profile_id") @db.Uuid
  // ltree column; GIST index created in raw SQL migration
  path      Unsupported("ltree")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Folder[] @relation("FolderTree")
  profile  Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  flows    Flow[]

  @@index([parentId])
  @@index([profileId])
  @@map("folders")
}

model Tag {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique
  colorHex String? @map("color_hex")
  flows    FlowTag[]

  @@map("tags")
}

model Flow {
  id                String     @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  type              FlowType
  status            FlowStatus @default(INACTIVE)
  isExclusive       Boolean    @default(false) @map("is_exclusive")
  folderId          String?    @map("folder_id") @db.Uuid
  profileId         String?    @map("profile_id") @db.Uuid
  projectSlug       String?    @map("project_slug")
  config            Json?
  orchestratorRules Json?      @map("orchestrator_rules")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  folder   Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  profile  Profile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tags          FlowTag[]
  sessions      FlowSession[]
  events        FlowEvent[]
  bufferItems   FlowBufferItem[]
  subscriptions CardFlowSubscription[]

  @@index([folderId])
  @@index([profileId])
  @@index([projectSlug])
  @@index([type])
  @@index([status])
  @@map("flows")
}

model FlowEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  flowId               String   @map("flow_id") @db.Uuid
  source               String   @default("external")
  eventType            String   @map("event_type")
  payload              Json     @default("{}")
  activeFlowSessionIds String[] @default([]) @map("active_flow_session_ids") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, createdAt])
  @@map("flow_events")
}

model FlowTag {
  flowId String @map("flow_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([flowId, tagId])
  @@map("flow_tags")
}

model FlowSession {
  id        String    @id @default(uuid()) @db.Uuid
  flowId    String    @map("flow_id") @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  closedBy  String?   @map("closed_by")
  flow      Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, endedAt])
  @@map("flow_sessions")
}

model FlowBufferItem {
  id         String    @id @default(uuid()) @db.Uuid
  flowId     String    @map("flow_id") @db.Uuid
  dedupKey   String?   @map("dedup_key")
  payload    Json      @default("{}")
  enqueuedAt DateTime  @default(now()) @map("enqueued_at")
  flushedAt  DateTime? @map("flushed_at")

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, flushedAt])
  @@index([flowId, dedupKey])
  @@map("flow_buffer_items")
}

model Card {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id")
  title         String
  content       String?
  createdAt     DateTime @default(now()) @map("created_at")
  actions       Action[]
  subscriptions CardFlowSubscription[]

  @@map("cards")
}

model Action {
  id           String     @id @default(uuid()) @db.Uuid
  cardId       String     @map("card_id") @db.Uuid
  type         ActionType
  currentState String?    @map("current_state")
  config       Json?
  card         Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  events       ActionEvent[]

  @@index([cardId])
  @@map("actions")
}

model ActionEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  actionId             String   @map("action_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  eventType            String   @map("event_type")
  payload              Json     @default("{}")
  activeFlowSessionIds String[] @default([]) @map("active_flow_session_ids") @db.Uuid
  action               Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
  @@map("action_events")
}

model CardFlowSubscription {
  cardId          String     @map("card_id") @db.Uuid
  flowId          String     @map("flow_id") @db.Uuid
  requiredStatus  FlowStatus @default(ACTIVE) @map("required_status")
  onMatchBehavior String     @default("NOTIFY") @map("on_match_behavior")
  card            Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  flow            Flow       @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@id([cardId, flowId])
  @@map("card_flow_subscriptions")
}

model ProjectariumStand {
  id              String                    @id
  slug            String                    @unique
  name            String
  neuronWorkspace String                    @map("neuron_workspace")
  projectToken    String                    @unique @map("project_token")
  context         Json                      @default("{}")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  apps            ProjectariumAppRecord[]
  todos           ProjectariumTodoRecord[]
  notes           ProjectariumNoteRecord[]
  chronicle       ProjectariumEventRecord[]

  @@map("projectarium_stands")
}

model ProjectariumAppRecord {
  id                  String            @id
  standId             String            @map("stand_id")
  appName             String            @map("app_name")
  port                Int
  instanceId          String            @unique @map("instance_id")
  leaseToken          String            @map("lease_token")
  environment         String            @default("dev")
  networkMode         String            @default("local") @map("network_mode")
  machineId           String?           @map("machine_id")
  machineName         String?           @map("machine_name")
  status              String            @default("ONLINE")
  healthUrl           String?           @map("health_url")
  lastPingAt          DateTime?         @map("last_ping_at")
  pingLatencyMs       Int?              @map("ping_latency_ms")
  consecutiveFailures Int               @default(0) @map("consecutive_failures")
  registeredAt        DateTime          @default(now()) @map("registered_at")
  metadata            Json?
  stand               ProjectariumStand @relation(fields: [standId], references: [id], onDelete: Cascade)

  @@index([standId])
  @@index([machineId])
  @@map("projectarium_apps")
}

model ProjectariumAppRunRecord {
  id              String    @id
  standId         String    @map("stand_id")
  standSlug       String    @map("stand_slug")
  standName       String    @map("stand_name")
  appName         String    @map("app_name")
  host            String    @default("localhost")
  port            Int
  instanceId      String    @unique @map("instance_id")
  environment     String    @default("dev")
  networkMode     String    @default("local") @map("network_mode")
  machineId       String    @default("unknown") @map("machine_id")
  machineName     String    @default("unknown") @map("machine_name")
  startedAt       DateTime  @default(now()) @map("started_at")
  lastHeartbeatAt DateTime  @default(now()) @map("last_heartbeat_at")
  endedAt         DateTime? @map("ended_at")
  durationSec     Int?      @map("duration_sec")
  endReason       String    @default("ACTIVE") @map("end_reason")

  @@index([standId, startedAt])
  @@index([machineId, startedAt])
  @@index([endReason, startedAt])
  @@map("projectarium_app_runs")
}

model ProjectariumTodoRecord {
  id            String            @id
  standId       String            @map("stand_id")
  title         String
  completed     Boolean           @default(false)
  scope         String            @default("PROJECT")
  targetAppName String?           @map("target_app_name")
  author        String            @default("developer")
  priority      String            @default("MEDIUM")
  createdAt     DateTime          @default(now()) @map("created_at")
  completedAt   DateTime?         @map("completed_at")
  stand         ProjectariumStand @relation(fields: [standId], references: [id], onDelete: Cascade)

  @@index([standId])
  @@map("projectarium_todos")
}

model ProjectariumNoteRecord {
  id        String            @id
  standId   String            @map("stand_id")
  title     String?
  content   String
  author    String            @default("developer")
  tags      String[]          @default([])
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  stand     ProjectariumStand @relation(fields: [standId], references: [id], onDelete: Cascade)

  @@index([standId, updatedAt])
  @@map("projectarium_notes")
}

model ProjectariumEventRecord {
  id            String            @id
  standId       String            @map("stand_id")
  type          String
  scope         String            @default("PROJECT")
  targetAppName String?           @map("target_app_name")
  description   String
  author        String            @default("system")
  metadata      Json?
  timestamp     DateTime          @default(now())
  stand         ProjectariumStand @relation(fields: [standId], references: [id], onDelete: Cascade)

  @@index([standId, timestamp])
  @@map("projectarium_events")
}
