{
  "name": "lemon-actions-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Lemon Actions - Reactive Flow Orchestration, Core Combinator & Autonomous Agent Suite",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm run --prefix packages/core-combinator build",
    "build:stack-bus": "npm run --prefix packages/lemon-stack-bus build",
    "build:projectarium": "npx --prefix packages/core-combinator tsc --project packages/lemon-projectarium/tsconfig.json",
    "build:sdk": "npm run --prefix packages/core-combinator-sdk build",
    "build:neurons": "npm run --prefix packages/lemon-seasons-neurons build",
    "build:media-neurons": "npm run --prefix packages/lemon-media-hub-neurons build",
    "build:ai-neurons": "npm run --prefix packages/lemon-ai-neurons build",
    "build:api": "npm run --prefix apps/api build",
    "build:web": "npm run --prefix apps/web build",
    "build:web:core": "npm run --prefix apps/web build:core",
    "build:web:projectarium": "npm run --prefix apps/web build:projectarium",
    "build:agent": "npm run --prefix apps/web build:agent",
    "test:web": "npm run --prefix apps/web test:ci",
    "build:all": "npm run build:core && npm run build:stack-bus && npm run build:projectarium && npm run build:sdk && npm run build:neurons && npm run build:media-neurons && npm run build:ai-neurons && npm run build:api && npm run build:web",
    "dev:up": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "dev:projectarium": "powershell -ExecutionPolicy Bypass -File ./scripts/start-projectarium-dev.ps1",
    "start:api": "npm run --prefix apps/api start:dev",
    "start:web": "npm run --prefix apps/web start",
    "start:projectarium": "npm run --prefix apps/web start:projectarium",
    "start:projectarium-mcp": "node packages/lemon-projectarium/dist/mcp/projectarium-mcp.server.js",
    "start:agent": "npm run --prefix apps/web start:agent",
    "dev:desktop": "npm run --prefix apps/desktop tauri:dev",
    "build:desktop": "npm run --prefix apps/desktop tauri:build",
    "migrate:data": "ts-node -r tsconfig-paths/register apps/api/src/migrations/agent-data-migration.ts"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}
