{
  "manifest_version": 3,
  "name": "Tab Cloud — Умное Облако Табов",
  "version": "1.0.0",
  "description": "Счетчик вкладок, история жизненного цикла и парящий облачный список с Drag-and-Drop.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Cloud",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage"
  ]
}
